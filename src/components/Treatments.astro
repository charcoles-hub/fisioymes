---
import { routes, t, treatmentsList, calliTitle, type Lang } from '../data/content';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const L = t[lang];
const r = routes[lang];
const items = treatmentsList[lang];
const base = import.meta.env.BASE_URL;
// Líneas fluidas decorativas: 14 curvas en abanico, arriba-izquierda.
const fanLines = Array.from({ length: 14 }, (_, i) =>
  `M -60 ${8 + i * 9} Q 150 ${300 + i * 5} 900 ${90 + i * 30}`);
---
<section class="tx-section" style={`--foto:url(${base}assets/tract-fondo.webp)`}>
  <svg class="sec-lines" viewBox="0 0 840 470" preserveAspectRatio="xMinYMin slice" aria-hidden="true" focusable="false">
    {fanLines.map(d => <path d={d} />)}
  </svg>
  <div class="wrap">
    <div class="section-head">
      <h2 set:html={calliTitle(L.pages.treatments.title)} />
      <p>{L.pages.treatments.subtitle}</p>
    </div>
    <div class="tx-grid">
      {items.map(c => (
        <article class="tx-card">
          <div class="tx-img"><img src={c.img} alt={c.name} loading="lazy" width="380" height="240" /></div>
          <div class="tx-body">
            <h3>{c.name}</h3>
            <p>{c.text}</p>
          </div>
        </article>
      ))}
    </div>
    <div class="tx-more"><a href={r.booking} class="btn btn-primary">{L.cta.book}</a></div>
  </div>
</section>

<style>
  .tx-section { position: relative; overflow: hidden; background: linear-gradient(125deg, #d7e8f6 0%, #e7f1fb 50%, var(--bg-soft) 100%); }
  .tx-section .wrap { position: relative; z-index: 1; }
  /* líneas fluidas (SVG, nítidas a cualquier tamaño) arriba-izquierda */
  .sec-lines {
    position: absolute; top: 0; left: 0; z-index: 0; pointer-events: none;
    width: min(74%, 900px); height: min(85%, 660px);
    -webkit-mask-image: linear-gradient(118deg, #000 25%, transparent 86%);
            mask-image: linear-gradient(118deg, #000 25%, transparent 86%);
  }
  .sec-lines path { fill: none; stroke: #fff; stroke-width: 1.7; opacity: .85; }
  /* foto de l'equip molt tènue, difuminada a la cantonada superior dreta */
  .tx-section::after {
    content: ''; position: absolute; top: 0; right: 0; z-index: 0; pointer-events: none;
    width: min(54%, 700px); height: min(72%, 480px);
    background: var(--foto) no-repeat center 30% / cover; opacity: .15;
    -webkit-mask-image: linear-gradient(215deg, #000, rgba(0,0,0,.3) 48%, transparent 74%);
            mask-image: linear-gradient(215deg, #000, rgba(0,0,0,.3) 48%, transparent 74%);
  }
  @media (max-width: 700px) { .tx-section::after { display: none; } }
  .tx-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px; }
  .tx-card { border: 1px solid var(--line); border-radius: 16px; overflow: hidden; background: #fff; box-shadow: 0 6px 20px rgba(20,50,80,.06); transition: transform .18s, box-shadow .18s; display: flex; flex-direction: column; }
  .tx-card:hover { transform: translateY(-4px); box-shadow: 0 12px 30px rgba(20,50,80,.12); }
  .tx-img { flex: 0 0 auto; }
  .tx-img img { display: block; width: 100%; aspect-ratio: 16/10; height: auto; object-fit: cover; }
  .tx-body { padding: 20px; }
  .tx-body h3 { color: var(--blue-dd); font-size: 1.15rem; }
  .tx-body p { color: var(--muted); font-size: .92rem; margin: 0; }
  .tx-more { text-align: center; margin-top: 40px; }
  @media (max-width: 520px) { .tx-grid { grid-template-columns: 1fr; } }
</style>
