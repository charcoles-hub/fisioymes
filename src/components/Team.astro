---
import { t, teamList, calliTitle, type Lang } from '../data/content';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const L = t[lang];
const members = teamList[lang];
const base = import.meta.env.BASE_URL;
---
<section class="team-section" style={`--fondo:url(${base}assets/fondo-fluid.webp);--foto:url(${base}assets/equip-fondo.webp)`}>
  <div class="wrap">
    <div class="section-head">
      <h2 set:html={calliTitle(L.pages.team.title)} />
      <p>{L.pages.team.intro}</p>
    </div>
    <div class="team-grid">
      {members.map(m => (
        <article class="team-card">
          <div class="team-img"><img src={m.img} alt={m.name} loading="lazy" width="320" height="380" /></div>
          <div class="team-body">
            <h3>{m.name}</h3>
            <p class="team-role">{m.role}</p>
            <p class="team-col">{m.col}</p>
            <ul class="team-bullets">
              {m.bullets.map(b => <li>{b}</li>)}
            </ul>
            {m.bio && (
              <details class="team-bio">
                <summary>{L.cta.readMore}</summary>
                {m.bio.map(p => <p>{p}</p>)}
              </details>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .team-section { position: relative; overflow: hidden; background: var(--bg-soft); }
  .team-section .wrap { position: relative; z-index: 1; }
  /* fondo fluido azul (líneas suaves) sobre toda la sección */
  .team-section::before {
    content: ''; position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background: var(--fondo) no-repeat left top / cover; opacity: .8;
  }
  /* foto del equip molt tènue, difuminada a la cantonada superior dreta */
  .team-section::after {
    content: ''; position: absolute; top: 0; right: 0; z-index: 0; pointer-events: none;
    width: min(54%, 700px); height: min(72%, 480px);
    background: var(--foto) no-repeat center 28% / cover; opacity: .16;
    -webkit-mask-image: linear-gradient(215deg, #000, rgba(0,0,0,.3) 48%, transparent 74%);
            mask-image: linear-gradient(215deg, #000, rgba(0,0,0,.3) 48%, transparent 74%);
  }
  @media (max-width: 700px) { .team-section::after { display: none; } }
  .team-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 24px; }
  .team-card { border: 1px solid var(--line); border-radius: 16px; overflow: hidden; background: #fff; box-shadow: 0 6px 20px rgba(20,50,80,.06); display: flex; flex-direction: column; }
  .team-img { flex: 0 0 auto; }
  .team-img img { display: block; width: 100%; aspect-ratio: 4/5; height: auto; object-fit: cover; }
  .team-body { padding: 20px; }
  .team-body h3 { color: var(--blue-dd); font-size: 1.2rem; margin-bottom: 2px; }
  .team-role { color: var(--ink); font-weight: 600; font-size: .92rem; margin: 0 0 2px; }
  .team-col { color: var(--muted); font-size: .82rem; margin: 0 0 12px; }
  .team-bullets { list-style: none; padding: 0; margin: 0; }
  .team-bullets li { position: relative; padding: 5px 0 5px 18px; font-size: .88rem; color: var(--muted); border-bottom: 1px solid var(--line); }
  .team-bullets li:last-child { border-bottom: 0; }
  .team-bullets li::before { content: '›'; position: absolute; left: 2px; color: var(--blue); font-weight: 700; }
  /* ponytail: <details> nativo, sin JS de acordeón */
  .team-bio { margin-top: 12px; }
  .team-bio summary { cursor: pointer; list-style: none; color: var(--blue-d); font-weight: 600; font-size: .86rem; padding: 6px 0; }
  .team-bio summary::-webkit-details-marker { display: none; }
  .team-bio summary::after { content: ' ▾'; }
  .team-bio[open] summary::after { content: ' ▴'; }
  .team-bio p { font-size: .86rem; color: var(--muted); margin: 6px 0 0; }
  @media (max-width: 520px) { .team-grid { grid-template-columns: 1fr; } }
</style>
